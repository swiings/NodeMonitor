# Virtual environments
.venv/

# Python
__pycache__/
*.pyc
*.pyo

# Databases (runtime data, not source)
NMData/*.db
NMData/*.db-shm
NMData/*.db-wal
nodemonitor.db
nodemonitor.db-shm
nodemonitor.db-wal

# Runtime session state (machine-specific: BLE addresses, IPs, absolute paths)
NMData/active.json
NMData/sessions.json
NMData/listener_runtime.json

# TLS certificates (secrets)
*.pem

# Tile cache (large, regenerated at runtime)
NMDisplay/tile_cache/

# Claude Code settings
.claude/

# macOS
.DS_Store
